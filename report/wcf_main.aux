\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Sensitivity of WCF to the quantile grid size $K$ and the particle budget $M$ at $n=1000$ for designs IC0 to IC3. Panel A varies $K$ at $M=10$; Panel B varies $M$ at $K=25$. Entries are mean(SE) over ten replications. The native reference TCATE is evaluated on each cell's own $K$-grid, while the common and interior columns are evaluated on fixed 199-level targets. The primary setting $(K,M)=(25,10)$ appears in both panels.}}{15}{table.5}\protected@file@percent }
\newlabel{tab:sensitivity-km}{{5}{15}{Sensitivity of WCF to the quantile grid size $K$ and the particle budget $M$ at $n=1000$ for designs IC0 to IC3. Panel A varies $K$ at $M=10$; Panel B varies $M$ at $K=25$. Entries are mean(SE) over ten replications. The native reference TCATE is evaluated on each cell's own $K$-grid, while the common and interior columns are evaluated on fixed 199-level targets. The primary setting $(K,M)=(25,10)$ appears in both panels}{table.5}{}}
